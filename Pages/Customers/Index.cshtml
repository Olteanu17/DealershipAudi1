@page
@model DealershipAudi.Pages.Customers.IndexModel

@{
    ViewData["Title"] = "Customers";
}

<h1>List of Customers</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Customer</a>
</p>
<p>Below is the list of customers registered in the dealership system.</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Customer[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.Customer[0].Email)</th>
            <th>@Html.DisplayNameFor(model => model.Customer[0].Phone)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model.Customer)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => customer.Name)</td>
                <td>@Html.DisplayFor(modelItem => customer.Email)</td>
                <td>@Html.DisplayFor(modelItem => customer.Phone)</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@customer.ID" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="./Details" asp-route-id="@customer.ID" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="./Delete" asp-route-id="@customer.ID" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
